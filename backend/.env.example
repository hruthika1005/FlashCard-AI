# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ============================================
# MONGODB CONFIGURATION
# ============================================
MONGO_URI=mongodb://127.0.0.1:27017/ai-flashcard-generator

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ============================================
# CLOUDINARY (Image / File Storage)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ============================================
# GOOGLE CLOUD VISION (OCR)
# ============================================
# Path to the downloaded service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./src/config/google-vision-key.json
GOOGLE_PROJECT_ID=your_google_cloud_project_id

# ============================================
# OPENAI (Flashcard Generation)
# ============================================
OPENAI_API_KEY=sk-replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ============================================
# FILE UPLOAD LIMITS
# ============================================
MAX_FILE_UPLOAD_MB=10
